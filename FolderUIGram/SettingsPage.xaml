<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FolderUIGram.SettingsPage"
             Title="Settings &amp; Account"
             Background="{DynamicResource AppBackgroundGradientBrush}">

    <ScrollView>
        <VerticalStackLayout Padding="32,28" Spacing="20" MaximumWidthRequest="960" HorizontalOptions="Fill">

            <VerticalStackLayout Spacing="4">
                <Label Text="Settings &amp; Account" Style="{StaticResource PageTitle}"/>
                <Label Text="Manage your account and application settings." Style="{StaticResource MutedText}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Account Status" Style="{StaticResource SectionTitle}"/>
                        <HorizontalStackLayout Spacing="10">
                            <Border x:Name="StatusDot" WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" Background="{DynamicResource DangerBrush}"/>
                            <Label x:Name="StatusLabel" Text="Disconnected" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="UserDetailLabel" Text="Please enter API configuration and sign in." Style="{StaticResource MutedText}"/>
                        <Button x:Name="LogoutButton" Text="Logout Account" Clicked="LogoutButton_Clicked" Style="{StaticResource DangerButton}" Margin="0,6,0,0" IsVisible="False"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="FFmpeg Status" Style="{StaticResource SectionTitle}"/>
                        <HorizontalStackLayout Spacing="10">
                            <Border x:Name="FFmpegStatusDot" WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Center" Background="{DynamicResource DangerBrush}"/>
                            <Label x:Name="FFmpegStatusLabel" Text="Not Installed" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="FFmpegDetailLabel" Text="FFmpeg is required for video conversion." Style="{StaticResource MutedText}" LineBreakMode="MiddleTruncation" MaxLines="2"/>
                        <Button x:Name="CopyFFmpegPathButton" Text="Copy full path" Clicked="CopyFFmpegPathButton_Clicked" Style="{StaticResource SoftButton}" HeightRequest="40" IsVisible="False"/>
                        <Button x:Name="DownloadFFmpegButton" Text="Download FFmpeg" Clicked="DownloadFFmpegButton_Clicked" Style="{StaticResource PrimaryButton}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Appearance" Style="{StaticResource SectionTitle}"/>
                    <Label Text="Choose a color palette for the app." Style="{StaticResource MutedText}"/>
                    <Border Style="{StaticResource InsetCard}" HeightRequest="52" Margin="0,6,0,0">
                        <Picker x:Name="ThemePicker" Title="Theme" TextColor="{DynamicResource TextPrimary}" TitleColor="{DynamicResource TextSecondary}" VerticalOptions="Center" FontSize="14"
                                SelectedIndexChanged="ThemePicker_SelectedIndexChanged"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CredentialsCard" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Telegram API Settings" Style="{StaticResource SectionTitle}"/>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="API ID" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <Entry x:Name="ApiIdEntry" Placeholder="e.g. 123456" Style="{StaticResource ThemedEntry}" Keyboard="Numeric"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="API Hash" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <Entry x:Name="ApiHashEntry" Placeholder="e.g. 8a2f1c843..." Style="{StaticResource ThemedEntry}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InsetCard}">
                            <Entry x:Name="PhoneNumberEntry" Placeholder="+1234567890" Style="{StaticResource ThemedEntry}" Keyboard="Telephone"/>
                        </Border>
                    </VerticalStackLayout>
                    <Button x:Name="LoginButton" Text="Connect &amp; Send Code" Clicked="LoginButton_Clicked" Style="{StaticResource PrimaryButton}" HeightRequest="52"/>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CodePanel" IsVisible="False" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Enter Verification Code" Style="{StaticResource SectionTitle}"/>
                    <Label Text="We have sent a verification code to your Telegram app." Style="{StaticResource MutedText}"/>
                    <Border Style="{StaticResource InsetCard}">
                        <Entry x:Name="CodeEntry" Placeholder="Verification Code" Style="{StaticResource ThemedEntry}" Keyboard="Numeric"/>
                    </Border>
                    <Button x:Name="SubmitCodeButton" Text="Verify &amp; Sign In" Clicked="SubmitCodeButton_Clicked" Style="{StaticResource PrimaryButton}"/>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="TwoFactorPanel" IsVisible="False" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Enter 2FA Password" Style="{StaticResource SectionTitle}"/>
                    <Label Text="Your Telegram account is protected with a two-step verification password." Style="{StaticResource MutedText}"/>
                    <Border Style="{StaticResource InsetCard}">
                        <Entry x:Name="TwoFactorEntry" IsPassword="True" Placeholder="2FA Password" Style="{StaticResource ThemedEntry}"/>
                    </Border>
                    <Button x:Name="SubmitTwoFactorButton" Text="Submit Password" Clicked="SubmitTwoFactorButton_Clicked" Style="{StaticResource PrimaryButton}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>



