<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FolderUIGram.MessagesPage"
             Title="Send Messages"
             Background="{DynamicResource AppBackgroundGradientBrush}">

    <Grid>
        <ScrollView x:Name="MainContentScroll" IsVisible="True">
            <VerticalStackLayout Padding="32,28" Spacing="20" MaximumWidthRequest="860" HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Quick Message" Style="{StaticResource PageTitle}"/>
                    <Label Text="Send text messages to your Telegram chats and channels." Style="{StaticResource MutedText}"/>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="22">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Select Destination" Style="{StaticResource FieldLabel}"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource InsetCard}" HeightRequest="52">
                                    <Picker x:Name="TargetChatPicker" Title="Select a chat or channel..." TitleColor="{DynamicResource TextSecondary}"
                                            TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" FontSize="14"
                                            ItemDisplayBinding="{Binding DisplayTitle}"/>
                                </Border>
                                <Button x:Name="LoadChatsButton" Grid.Column="1" Text="Refresh" Clicked="LoadChatsButton_Clicked"
                                        Style="{StaticResource SoftButton}" HeightRequest="50" WidthRequest="110"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Compose Message" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InsetCard}" Padding="14,10" HeightRequest="240">
                                <Grid RowDefinitions="*, Auto">
                                    <Editor x:Name="MessageEditor" Placeholder="Type your message here..." MaxLength="4096"
                                            PlaceholderColor="{DynamicResource TextSecondary}" TextColor="{DynamicResource TextPrimary}"
                                            FontSize="14" AutoSize="Disabled" BackgroundColor="Transparent"/>
                                    <Label Grid.Row="1" HorizontalOptions="End" FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                           Text="{Binding Text.Length, Source={x:Reference MessageEditor}, StringFormat='{0}/4096'}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Button x:Name="SendMessageButton" Text="Send Message" Clicked="SendMessageButton_Clicked"
                                Style="{StaticResource PrimaryButton}" HeightRequest="52" FontSize="16"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="StatusCard" Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" Padding="18" IsVisible="False">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Send Status" Style="{StaticResource FieldLabel}"/>
                        <Label x:Name="StatusTextLabel" Text="Waiting..." Style="{StaticResource BodyText}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="NotLoggedInPanel" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
            <Border Style="{StaticResource Card}" WidthRequest="360" Padding="30">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                    <Label Text="Sign in required" Style="{StaticResource PageTitle}" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="Please configure your Telegram API details and login in Settings to send messages."
                           Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"/>
                    <Button Text="Go to Settings" Clicked="GoToSettingsButton_Clicked" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>


