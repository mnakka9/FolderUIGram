<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FolderUIGram.Converters"
             x:Class="FolderUIGram.ActionsPage"
             Title="Upload Folders"
             Background="{DynamicResource AppBackgroundGradientBrush}">

    <Grid>
        <ScrollView x:Name="MainContentScroll" IsVisible="True">
            <VerticalStackLayout Padding="32,28" Spacing="20" MaximumWidthRequest="860" HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Upload Folders" Style="{StaticResource PageTitle}"/>
                        <Label Text="Select a local folder and send it to your Telegram channel." Style="{StaticResource MutedText}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource ProfileStrip}" VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                    Background="{DynamicResource SuccessBrush}" VerticalOptions="Center"/>
                            <Label x:Name="UserLabel" FontSize="13" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" MaximumWidthRequest="260" Text="Logged in as: User"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="22">
                        <Label Text="Upload Configuration" Style="{StaticResource SectionTitle}"/>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Folder to upload" Style="{StaticResource FieldLabel}"/>
                            <Button x:Name="ChoseFolder" Text="Choose Local Folder" Clicked="ChoseFolder_Clicked"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"/>
                            <Label x:Name="FolderPathLabel" Text="No folder selected" Style="{StaticResource MutedText}" LineBreakMode="MiddleTruncation"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Destination Chat / Channel" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InsetCard}" HeightRequest="52">
                                <Picker x:Name="ChannelsListView" Title="Choose target channel..." TitleColor="{DynamicResource TextSecondary}"
                                        TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" FontSize="14"
                                        ItemDisplayBinding="{Binding DisplayTitle}"
                                        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"/>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Convert non-MP4 videos to MP4" Style="{StaticResource FieldLabel}"/>
                                <Label Text="Uses FFmpeg so videos play inline in Telegram." Style="{StaticResource MutedText}"/>
                            </VerticalStackLayout>
                            <Switch x:Name="ConvertVideosSwitch" Grid.Column="1" IsToggled="False" VerticalOptions="Center"
                                    OnColor="{DynamicResource AccentPrimary}" ThumbColor="White"
                                    IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"/>
                        </Grid>

                        <Button x:Name="StartUploadButton" Text="Start Upload to Telegram" Clicked="StartUploadButton_Clicked"
                                Style="{StaticResource PrimaryButton}" HeightRequest="52" FontSize="16"
                                IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ProgressCard" Style="{StaticResource Card}" IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Uploading Files..." Style="{StaticResource SectionTitle}"/>
                        <Label x:Name="CurrentFileLabel" Text="{Binding CurrentFileText}" Style="{StaticResource MutedText}" LineBreakMode="TailTruncation"/>
                        <ProgressBar x:Name="UploadProgressBar" Progress="{Binding OverallProgress}" ProgressColor="{DynamicResource AccentPrimary}" HeightRequest="8"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="ProgressDetailsLabel" Text="{Binding OverallProgressText}" Style="{StaticResource MutedText}"/>
                            <Label Grid.Column="1" Text="{Binding OverallProgress, StringFormat='{0:P0}'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource AccentPrimary}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="LogCard" Style="{StaticResource Card}" HeightRequest="300" IsVisible="False">
                    <Grid RowDefinitions="Auto, *" RowSpacing="10">
                        <Label Text="Activity &amp; Operation Logs" Style="{StaticResource SectionTitle}"/>
                        <ScrollView x:Name="LogScrollView" Grid.Row="1">
                            <Label x:Name="LogTextArea" Text="{Binding LogText}" FontSize="11" FontFamily="Consolas,Courier New"
                                   TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap"/>
                        </ScrollView>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="NotLoggedInPanel" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
            <Border Style="{StaticResource Card}" WidthRequest="360" Padding="30">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                    <Label Text="Sign in required" Style="{StaticResource PageTitle}" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="Please configure your Telegram API details and login in Settings to use the upload page."
                           Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"/>
                    <Button Text="Go to Settings" Clicked="GoToSettingsButton_Clicked" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>


